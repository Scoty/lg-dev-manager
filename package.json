{
  "name": "lg-dev-manager",
  "private": true,
  "version": "1.0.1",
  "description": "LG Dev Manager: manage LG webOS TVs in Developer Mode or rooted, from your browser",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @lgdm/web dev",
    "dev:bridge": "pnpm --filter lg-dev-manager-bridge dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --parallel test",
    "e2e": "pnpm --filter @lgdm/web build && pnpm --filter @lgdm/web e2e",
    "dev:rig": "pnpm --filter @lgdm/web build && pnpm --filter @lgdm/web e2e:server",
    "bridge": "node apps/bridge/dist/cli.js"
  }
}
